#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Sign an .apf package with an Ed25519 key held by gpg-agent, such as the
signing key of an OpenPGP card (YubiKey). The card asks for its PIN.

    apf-sign-gpg --key A784C9FCCB1867FE app.apf
    apf-sign-gpg --key A784C9FCCB1867FE --export-pub platform.pub

--key takes a key fingerprint, long key id or keygrip. The signature is the
same as `cosmic sign` makes with a key file (SPEC.md); check the result with
`cosmic verify`.
"""
import argparse
import base64
import hashlib
import os
import re
import subprocess
import sys
import zipfile

DOMAIN = b"cosmic-apf-1\n"
ENTRY_TIME = (2000, 1, 1, 0, 0, 0)


def fail(message):
    sys.exit("apf-sign-gpg: " + message)


def find_keygrip(key):
    """The keygrip of a secret key or subkey given by fingerprint, key id or keygrip."""
    key = key.upper().removeprefix("0X")
    if not re.fullmatch(r"[0-9A-F]{16}|[0-9A-F]{40}", key):
        fail("--key must be a fingerprint, a 16-digit key id or a keygrip")
    listing = subprocess.run(
        ["gpg", "--batch", "--with-colons", "--with-keygrip", "--list-secret-keys"],
        capture_output=True, text=True, check=True).stdout
    fingerprint = None
    for line in listing.splitlines():
        fields = line.split(":")
        if fields[0] == "fpr":
            fingerprint = fields[9]
        elif fields[0] == "grp":
            grip = fields[9]
            if key == grip or (fingerprint and fingerprint.endswith(key)):
                return grip
    fail("no secret key " + key)


def agent(commands):
    """Runs Assuan commands through gpg-connect-agent; returns the decoded data."""
    result = subprocess.run(["gpg-connect-agent"], input="\n".join(commands + ["/bye"]).encode(),
                            capture_output=True, check=True)
    data = bytearray()
    for line in result.stdout.split(b"\n"):
        if line.startswith(b"ERR"):
            fail("gpg-agent: " + line.decode(errors="replace"))
        if line.startswith(b"D "):
            data += re.sub(rb"%([0-9A-Fa-f]{2})", lambda m: bytes([int(m.group(1), 16)]), line[2:])
    return bytes(data)


def parse_sexp(data):
    """Parses a canonical S-expression into nested lists of bytes."""
    def parse(position):
        items = []
        while position < len(data):
            char = data[position:position + 1]
            if char == b"(":
                item, position = parse(position + 1)
                items.append(item)
            elif char == b")":
                return items, position + 1
            else:
                colon = data.index(b":", position)
                length = int(data[position:colon])
                items.append(data[colon + 1:colon + 1 + length])
                position = colon + 1 + length
        return items, position
    return parse(0)[0][0]


def field(sexp, name):
    """The value after name in the first list starting with it, searched depth first."""
    if isinstance(sexp, list):
        if sexp and sexp[0] == name and len(sexp) > 1:
            return sexp[1]
        for item in sexp:
            found = field(item, name)
            if found is not None:
                return found
    return None


def public_key(grip):
    sexp = parse_sexp(agent(["READKEY " + grip]))
    curve = field(sexp, b"curve")
    q = field(sexp, b"q")
    if curve not in (b"Ed25519", b"ed25519") or q is None:
        fail("key %s is not Ed25519" % grip)
    if len(q) == 33 and q[0] == 0x40:
        q = q[1:]
    if len(q) != 32:
        fail("unexpected Ed25519 public key size")
    return q


def key_id(public):
    return hashlib.sha256(public).hexdigest()[:16]


def sign_digest(grip, digest, package):
    description = "Sign the Starry package %s" % os.path.basename(package)
    escaped = re.sub(r"[%+ \n]", lambda m: "%%%02X" % ord(m.group(0)), description)
    sexp = parse_sexp(agent([
        "SIGKEY " + grip,
        "SETKEYDESC " + escaped,
        "SETHASH --hash=sha512 " + digest.hex(),
        "PKSIGN",
    ]))
    r, s = field(sexp, b"r"), field(sexp, b"s")
    if r is None or s is None or len(r) > 32 or len(s) > 32:
        fail("gpg-agent returned no Ed25519 signature")
    return r.rjust(32, b"\0") + s.rjust(32, b"\0")


def add_signature(package, name, text):
    """Rewrites the zip with the signature, replacing one of the same name."""
    temporary = package + ".tmp"
    with zipfile.ZipFile(package) as source, zipfile.ZipFile(temporary, "w") as target:
        for info in source.infolist():
            if info.filename != name:
                target.writestr(info, source.read(info.filename))
        info = zipfile.ZipInfo(name, ENTRY_TIME)
        info.compress_type = zipfile.ZIP_DEFLATED
        info.external_attr = 0o100644 << 16
        target.writestr(info, text)
    os.replace(temporary, package)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--key", required=True, help="fingerprint, long key id or keygrip")
    parser.add_argument("--export-pub", metavar="FILE", help="write the public key for /etc/cosmic/keys")
    parser.add_argument("package", nargs="?", help="the .apf to sign")
    args = parser.parse_args()
    if not args.package and not args.export_pub:
        parser.error("give a package to sign, --export-pub, or both")

    grip = find_keygrip(args.key)
    public = public_key(grip)
    encoded = base64.b64encode(public).decode()
    if args.export_pub:
        with open(args.export_pub, "x") as file:
            file.write("key ed25519 %s\n" % encoded)
        print("wrote %s, key id %s" % (args.export_pub, key_id(public)))
    if args.package:
        with zipfile.ZipFile(args.package) as package:
            files = package.read("META-INF/files")
        digest = hashlib.sha512(DOMAIN + files).digest()
        signature = sign_digest(grip, digest, args.package)
        text = "key ed25519 %s\nsig %s\n" % (encoded, base64.b64encode(signature).decode())
        add_signature(args.package, "META-INF/%s.sig" % key_id(public), text)
        print("signed %s with key id %s" % (args.package, key_id(public)))


if __name__ == "__main__":
    main()
