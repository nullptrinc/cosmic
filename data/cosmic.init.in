#!/bin/sh
# SPDX-License-Identifier: MIT
### BEGIN INIT INFO
# Provides:          cosmic
# Required-Start:    $local_fs constellation
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Publishes installed apps to Constellation
### END INIT INFO

cosmic=@bindir@/cosmic
log=/run/cosmic.log
# A private build keeps its libraries next to it (e.g. /opt/cosmic/lib).
[ -d @libdir@ ] && [ "@libdir@" != /usr/lib ] && export LD_LIBRARY_PATH=@libdir@

case "${1:-start}" in
	start)
		pidof cosmic >/dev/null && exit 0
		"$cosmic" serve >>"$log" 2>&1 </dev/null &
		;;
	stop)
		killall cosmic 2>/dev/null
		;;
	restart)
		"$0" stop
		sleep 0.5
		exec "$0" start
		;;
	status)
		pidof cosmic >/dev/null
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 2
		;;
esac
